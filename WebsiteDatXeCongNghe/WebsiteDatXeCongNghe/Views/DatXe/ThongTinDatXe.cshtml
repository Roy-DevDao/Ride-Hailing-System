    <script>


        $("#Search").on("input", function () {
            let keyword = $(this).val().toLowerCase();
            $(".table-body tr").each(function () {
                let rowText = $(this).text().toLowerCase();
                $(this).toggle(rowText.includes(keyword));
            });
        });
        $(document).ready(function () {
            const rowsPerPage = 4;
            let currentPage = 1;

            function paginateRows() {
                let keyword = $("#Search").val().toLowerCase();
                let rows = $(".table-body tr").filter(function () {
                    return $(this).text().toLowerCase().includes(keyword);
                });

                $(".table-body tr").hide();
                let totalPages = Math.ceil(rows.length / rowsPerPage);
                let start = (currentPage - 1) * rowsPerPage;
                let end = start + rowsPerPage;

                rows.slice(start, end).show();
                updatePaginationControls(totalPages);
            }

            function updatePaginationControls(totalPages) {
                let paginationHtml = "";

                // Mũi tên trái
                paginationHtml += `<button class="page-btn prev-btn" data-page="prev">&laquo;</button>`;

                for (let i = 1; i <= totalPages; i++) {
                    let activeClass = (i === currentPage) ? "active" : "";
                    paginationHtml += `<button class="page-btn ${activeClass}" data-page="${i}">${i}</button>`;
                }

                // Mũi tên phải
                paginationHtml += `<button class="page-btn next-btn" data-page="next">&raquo;</button>`;

                $(".pagination").html(paginationHtml);
            }

            $("#Search").on("input", function () {
                currentPage = 1; // Reset to first page after search
                paginateRows();
            });

            $(".pagination").on("click", ".page-btn", function () {
                let page = $(this).data("page");
                let keyword = $("#Search").val().toLowerCase();
                let rows = $(".table-body tr").filter(function () {
                    return $(this).text().toLowerCase().includes(keyword);
                });
                let totalPages = Math.ceil(rows.length / rowsPerPage);

                if (page === "prev" && currentPage > 1) currentPage--;
                else if (page === "next" && currentPage < totalPages) currentPage++;
                else if (!isNaN(page)) currentPage = parseInt(page);

                paginateRows();
            });


            paginateRows(); // Initial load
        });


    </script>


</body>

</html>

