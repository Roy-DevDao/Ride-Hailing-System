<body>
    <header class="header" style="display: flex; padding: 20px;">
        <a href="/TaiKhoan/Services"><button class="favorite styled" type="button">Quay lại</button></a>
        <div id="menu-btn" class="fas fa-bars"></div>
        <a href="#" class="logo"><h3 style="margin-right: 800px;"> <span>Dịch vụ</span> đặt xe công nghệ </h3> </a>
    </header>



    <div class="container">
        <div class="list-table ">

            <div class="btn-control" style="display: flex; width: 700px; justify-content: space-between;">

                <div class="seach" style="font-size: 20px">
                    <form>
                        <input type="text" id="Search" placeholder="Search..." class="input">
                    </form>
                </div>
            </div>
            <div class="content" style="margin: 0 auto; width: 400px; border-radius: 50px;">
                <h2>Thông tin đặt xe</h2>
                <a href=""><i class=""></i></a>

            </div>

            <form action="" method="post">
                <table class="table-form">
                    <thead class="table-header">
                        <tr>
                            <th>Mã đặt xe</th>
                            <th>Số điện thoại</th>
                            <th>Điểm đón</th>
                            <th>Điểm đến</th>
                            <th>Số km</th>
                            <th>Thời gian</th>
                            <th>Thành tiền</th>
                            <th>Loại xe</th>
                            <th>Thanh toán</th>
                            <th>Ngày Giờ Đặt</th>
                        </tr>
                    </thead>

                    <tbody class="table-body ">
                        @foreach (var item in Model)
                        {
                            <tr class="Search" id="row_@item.MaDatXe">
                                <td>@item.MaDatXe</td>
                                <td>@item.SoDienThoai</td>
                                <td>@item.DiemDon</td>
                                <td>@item.DiemDen</td>
                                <td>@item.SoKm</td>
                                <td>@item.ThoiGian</td>
                                <td>@item.ThanhTien</td>
                                <td>@item.LoaiXe</td>
                                <td>@item.HinhThucThanhToan</td>
                                <td>@item.NgayGioDat</td>

                            </tr>
                        }

                    </tbody>
                </table>
                <div class="pagination">

                </div>
            </form>
        </div>



    </div>

