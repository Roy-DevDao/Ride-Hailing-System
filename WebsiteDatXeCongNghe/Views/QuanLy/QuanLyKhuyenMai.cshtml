@model WebsiteDatXeCongNghe.ViewModel.MultipleData.MultipleData
@{
    ViewBag.Title = "QuanLyKhuyenMai";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <link href="~/css/BangDieuKhien.css" rel="stylesheet" />

    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <title>Quản lý khuyến mãi</title>
    <style>
        .popup {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.4);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 999;
        }

        .popup-content {
            background: #fff;
            padding: 25px;
            border-radius: 12px;
            width: 100%;
            max-width: 500px;
            box-shadow: 0 12px 30px rgba(0,0,0,0.2);
        }

            .popup-content h3 {
                margin-bottom: 15px;
                font-size: 20px;
            }

            .popup-content label {
                display: block;
                font-weight: bold;
                margin-top: 10px;
            }

            .popup-content input, .popup-content select {
                width: 100%;
                padding: 8px;
                margin-top: 5px;
                border-radius: 6px;
                border: 1px solid #ccc;
            }

        .popup-actions {
            margin-top: 15px;
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

            .popup-actions button {
                padding: 8px 16px;
                border: none;
                border-radius: 6px;
                cursor: pointer;
            }

        #saveEditBtn {
            background-color: #007bff;
            color: white;
        }

        #cancelEditBtn {
            background-color: #ccc;
            color: #000;
        }

    </style>
</head>

<body>

    <!-- Sidebar -->
    <div class="sidebar">
        <a href="#" class="logo">
            <i class='bx bx-code-alt'></i>
            <div class="logo-name"><span>Admin</span>Page</div>
        </a>
        <ul class="side-menu">
            <li><a href="/QuanLy/BangDieuKhien"><i class='bx bxs-dashboard'></i>Bảng điều khiển</a></li>
            <li><a href="/QuanLy/QuanLyKhachHang"><i class='bx bx-user-circle'></i>Quản lý khách hàng</a></li>
            <li><a href="/QuanLy/QuanLyTaiXe"><i class='bx bx-user-circle'></i>Quản lý tài xế</a></li>
            <li><a href="/QuanLy/QuanLyThongTinDatXe"><i class='bx bx-car'></i>Thông tin đặt xe</a></li>
            <li><a href="/QuanLy/QuanLyTaiKhoan"><i class='bx bx-key'></i>Quản lý tài khoản</a></li>
            <li><a href="/QuanLy/QuanLyDanhGia"><i class='bx bx-star'></i>Quản lý đánh giá</a></li>
            <li class="active"><a href="/QuanLy/QuanLyKhuyenMai"><i class='bx bx-money'></i>Quản lý khuyến mãi</a></li>
            <li><a href="/QuanLy/QuanLyThanhToan"><i class='bx bx-receipt'></i>Quản lý thanh toán</a></li>
            <li><a href="/QuanLy/QuanLyDanhGiaTaiXe"><i class='bx bx-star'></i>Đánh giá tài xế</a></li>
            <li><a href="/QuanLy/QuanLyTaiXeNhanChuyenXe"><i class='bx bx-cycling'></i>Tài xế nhận chuyến xe</a></li>
            <li><a href="/QuanLy/QuanLyTaiKhoanNganHang"><i class='bx bx-credit-card'></i>Tài khoản ngân hàng</a></li>
            <li><a href="/QuanLy/QuanLyQuyenTaiKhoan"><i class='bx bx-capsule'></i>Quyền tài khoản</a></li>
            <li><a href="/QuanLy/QuanLyPhanQuyen"><i class='bx bx-user-plus'></i>Quản lý phân quyền</a></li>
            <li><a href="#"><i class='bx bx-cog'></i>Cài đặt</a></li>
        </ul>
        <ul class="side-menu">
            <li>
                <a href="/TaiKhoan/DangXuat" class="logout">
                    <i class='bx bx-log-out-circle'></i>
                    Đăng xuất
                </a>
            </li>
        </ul>
    </div>
    <!-- End of Sidebar -->
    <!-- Main Content -->
    <div class="content">
        <!-- Navbar -->
        <nav>
            <i class='bx bx-menu'></i>
            <form action="#">
                <div class="form-input">
                    <input type="search" id="Search" placeholder="Tìm kiếm...">
                    <button class="search-btn" type="submit"><i class='bx bx-search'></i></button>
                </div>
            </form>
            <input type="checkbox" id="theme-toggle" hidden>
            <label for="theme-toggle" class="theme-toggle"></label>
            <a href="#" class="notif">
                <i class='bx bx-bell'></i>
                <span class="count">12</span>
            </a>
            <a href="#" class="profile">
                <img src="~/image/QuanLy/logo.png" />
            </a>
        </nav>

        <!-- End of Navbar -->

        <main>

            <div class="bottom-data">
                <div class="orders">
                    <div class="header">
                        <i class='bx bx-money'></i>
                        <h3>Quản lý khuyến mãi</h3>
                        <i class='bx bx-filter'></i>
                        <i class='bx bx-search'></i>
                        <button class="add-button">Thêm khuyến mãi</button>
                    </div>
                    <table>
                        <thead>
                            <tr>
                                <th>STT</th>
                                <th>Mã code</th>
                                <th>Tên khuyến mãi</th>
                                <th>Giảm giá</th>
                                <th>Ngày bắt đầu</th>
                                <th>Ngày kết thúc</th>
                                <th>Nội dung</th>
                                <th>Trạng thái</th>
                                <th colspan="2">Tùy chỉnh</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.khuyenMais.Count(); i++)
                            {
                                var item = Model.khuyenMais.ElementAt(i);
                                <tr class="Search" id="row_@item.MaKhuyenMai">
                                    <td>@(i + 1).</td>
                                    <td>@item.MaCode</td>
                                    <td style="display:none;">@item.MaKhuyenMai</td>
                                    <td>@item.TenKhuyenMai</td>
                                    <td>@item.PhanTram</td>
                                    <td>@item.NgayBatDau.ToString("dd-MM-yyyy")</td>
                                    <td>@item.NgayKetThuc.ToString("dd-MM-yyyy")</td>
                                    <td>@item.NoiDung</td>
                                    <td>
                                        @if (item.TrangThai)
                                        {
                                            <span class="status completed">Available</span>
                                        }
                                        else
                                        {
                                            <span class="status pending">Unavailable</span>
                                        }
                                    </td>
                                    <td><button class="edit-button">Sửa</button></td>
                                    <td><button class="delete-button">Xóa</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>


        </main>
    </div>
    <div id="Popup" class="popup" style="display: none;">
        <div class="popup-content">
            <h3 id="popup-title">Sửa khuyến mãi</h3>
            <input type="hidden" id="editMaKhuyenMai" />

            <label>Mã code</label>
            <input type="text" id="editMaCode" />

            <label>Tên khuyến mãi</label>
            <input type="text" id="editTenKhuyenMai" />

            <label>Phần trăm giảm</label>
            <input type="number" id="editPhanTram" />

            <label>Ngày bắt đầu</label>
            <input type="date" id="editNgayBatDau" />

            <label>Ngày kết thúc</label>
            <input type="date" id="editNgayKetThuc" />

            <label>Nội dung</label>
            <input type="text" id="editNoiDung" />

            <label>Trạng thái</label>
            <select id="editTrangThai">
                <option value="true">Available</option>
                <option value="false">Unavailable</option>
            </select>

            <div class="popup-actions">
                <button id="saveEditBtn">Lưu</button>
                <button id="cancelEditBtn">Hủy</button>
            </div>
        </div>
    </div>
    <script>
        let isEditMode = false;
        $(document).ready(function () {
            function Contains(text_one, text_two) {
                var cleanTextOne = text_one.replace(/\s/g, "");
                var cleanTextTwo = text_two.replace(/\s/g, "");

                if (cleanTextOne.indexOf(cleanTextTwo) !== -1) {
                    return true;
                }
            }

            $("#Search").on('input', function () {
                var searchText = $("#Search").val().toLowerCase();
                $(".Search").each(function () {
                    if (!Contains($(this).text().toLowerCase(), searchText)) {
                        $(this).hide();
                    } else {
                        $(this).show();
                    }
                });
            });
        });
        $('.edit-button').click(function () {
            isEditMode = true;
            var row = $(this).closest('tr');
            var maKhuyenMai = row.attr('id').split('_')[1];
            var maCode = row.find('td:eq(1)').text().trim();
            var ten = row.find('td:eq(3)').text().trim();
            var phanTram = row.find('td:eq(4)').text().trim();
            var batDau = row.find('td:eq(5)').text().trim();
            var ketThuc = row.find('td:eq(6)').text().trim();
            var noiDung = row.find('td:eq(7)').text().trim();
            var trangThai = row.find('td:eq(8)').text().includes("Available");

            $('#editMaKhuyenMai').val(maKhuyenMai);
            $('#editMaCode').val(maCode);
            $('#editTenKhuyenMai').val(ten);
            $('#editPhanTram').val(phanTram);
            $('#editNgayBatDau').val(convertDateFormat(batDau));
            $('#editNgayKetThuc').val(convertDateFormat(ketThuc));
            $('#editNoiDung').val(noiDung);
            $('#editTrangThai').val(trangThai ? 'true' : 'false');

            $('.popup-content h3').text('Sửa khuyến mãi');
            $('#Popup').fadeIn();
        });

        // Hủy popup
        $('#cancelEditBtn').click(function () {
            $('#Popup').fadeOut();
        });

        // Gửi sửa
        $('#saveEditBtn').click(function () {
            const data = {
                maCode: $('#editMaCode').val(),
                ten: $('#editTenKhuyenMai').val(),
                giamgia: parseInt($('#editPhanTram').val()),
                ngayBatDau: $('#editNgayBatDau').val(),
                ngayKetThuc: $('#editNgayKetThuc').val(),
                noiDung: $('#editNoiDung').val(),
                trangThai: $('#editTrangThai').val() === 'true'
            };

            if (isEditMode) {
                data.id = parseInt($('#editMaKhuyenMai').val());
                $.post('/QuanLy/SuaKhuyenMai', data, function (res) {
                    if (res.success) {
                        alert("Đã cập nhật!");
                        location.reload();
                    } else {
                        alert("Lỗi cập nhật");
                    }
                }).fail(function () {
                    alert("Lỗi server");
                });
            } else {
                $.post('/QuanLy/ThemKhuyenMai', data, function (res) {
                    if (res.success) {
                        alert("Đã thêm!");
                        location.reload();
                    } else {
                        alert("Lỗi thêm khuyến mãi");
                    }
                }).fail(function () {
                    alert("Lỗi server");
                });
            }
        });


        // Xóa khuyến mãi
        $('.delete-button').click(function () {
            if (!confirm("Bạn có chắc muốn xóa?")) return;

            var id = $(this).closest('tr').attr('id').split('_')[1];
            $.ajax({
                type: 'POST',
                url: '/QuanLy/XoaKhuyenMai',
                data: { id: id },
                success: function (res) {
                    if (res.success) {
                        alert("Đã xóa!");
                        location.reload();
                    } else {
                        alert("Không thể xóa");
                    }
                },
                error: function () {
                    alert("Lỗi server");
                }
            });
        });
        $('.add-button').click(function () {
            isEditMode = false;

            // Clear các input
            $('#editMaKhuyenMai').val('');
            $('#editMaCode').val('');
            $('#editTenKhuyenMai').val('');
            $('#editPhanTram').val('');
            $('#editNgayBatDau').val('');
            $('#editNgayKetThuc').val('');
            $('#editNoiDung').val('');
            $('#editTrangThai').val('true');

            $('.popup-content h3').text('Thêm khuyến mãi');
            $('#Popup').fadeIn();
        });
        function convertDateFormat(dateStr) {
            var parts = dateStr.split('-');
            if (parts.length === 3) {
                return `${parts[2]}-${parts[1]}-${parts[0]}`;
            }
            return '';
        }
    </script>
    <!-- Scripts -->
    <script src="~/js/BangDieuKhien.js"></script>
    <!-- Include jQuery library -->
</body>

</html>

