@model WebsiteDatXeCongNghe.ViewModel.MultipleData.MultipleData
@{
    ViewBag.Title = "QuanLyTaiXe";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <link href="~/css/BangDieuKhien.css" rel="stylesheet" />
    <script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>
    <!-- Include SweetAlert library -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11" />
    <!-- Include SweetAlert library -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <title>Quản lý tài xế</title>
    <style>
        .popup-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.4);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
        }

        .popup-content {
            background: #fff;
            padding: 30px 25px;
            border-radius: 12px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
            width: 100%;
            max-width: 500px;
            font-family: Arial, sans-serif;
        }

            .popup-content h3 {
                margin-top: 0;
                text-align: center;
                margin-bottom: 20px;
                color: #333;
            }

            .popup-content form {
                display: flex;
                flex-direction: column;
                gap: 15px;
            }

            .popup-content label {
                font-weight: 600;
                color: #555;
            }

            .popup-content input[type="text"],
            .popup-content input[type="email"],
            .popup-content input[type="date"],
            .popup-content input[type="file"] {
                padding: 8px 10px;
                border: 1px solid #ccc;
                border-radius: 6px;
                font-size: 14px;
                width: 100%;
            }

            .popup-content button {
                padding: 10px;
                font-size: 15px;
                border: none;
                border-radius: 6px;
                cursor: pointer;
                transition: background 0.3s;
            }

                .popup-content button[type="submit"] {
                    background-color: #4CAF50;
                    color: white;
                }

                    .popup-content button[type="submit"]:hover {
                        background-color: #45a049;
                    }

            .popup-content #popup-cancel {
                background-color: #f44336;
                color: white;
            }

                .popup-content #popup-cancel:hover {
                    background-color: #e53935;
                }

    </style>
</head>

<body>

    <!-- Sidebar -->
    <div class="sidebar">
        <a href="#" class="logo">
            <i class='bx bx-code-alt'></i>
            <div class="logo-name"><span>Admin</span>Page</div>
        </a>
        <ul class="side-menu">
            <li><a href="/QuanLy/BangDieuKhien"><i class='bx bxs-dashboard'></i>Bảng điều khiển</a></li>
            <li><a href="/QuanLy/QuanLyKhachHang"><i class='bx bx-user-circle'></i>Quản lý khách hàng</a></li>
            <li class="active"><a href="/QuanLy/QuanLyTaiXe"><i class='bx bx-user-circle'></i>Quản lý tài xế</a></li>
            <li><a href="/QuanLy/QuanLyThongTinDatXe"><i class='bx bx-car'></i>Thông tin đặt xe</a></li>
            <li><a href="/QuanLy/QuanLyTaiKhoan"><i class='bx bx-key'></i>Quản lý tài khoản</a></li>
            <li><a href="/QuanLy/QuanLyDanhGia"><i class='bx bx-star'></i>Quản lý đánh giá</a></li>
            <li><a href="/QuanLy/QuanLyKhuyenMai"><i class='bx bx-money'></i>Quản lý khuyến mãi</a></li>
            <li><a href="/QuanLy/QuanLyThanhToan"><i class='bx bx-receipt'></i>Quản lý thanh toán</a></li>
            <li><a href="/QuanLy/QuanLyDanhGiaTaiXe"><i class='bx bx-star'></i>Đánh giá tài xế</a></li>
            <li><a href="/QuanLy/QuanLyTaiXeNhanChuyenXe"><i class='bx bx-cycling'></i>Tài xế nhận chuyến xe</a></li>
            <li><a href="/QuanLy/QuanLyTaiKhoanNganHang"><i class='bx bx-credit-card'></i>Tài khoản ngân hàng</a></li>
            <li><a href="/QuanLy/QuanLyQuyenTaiKhoan"><i class='bx bx-capsule'></i>Quyền tài khoản</a></li>
            <li><a href="/QuanLy/QuanLyPhanQuyen"><i class='bx bx-user-plus'></i>Quản lý phân quyền</a></li>
            <li><a href="#"><i class='bx bx-cog'></i>Cài đặt</a></li>
        </ul>
        <ul class="side-menu">
            <li>
                <a href="#" class="logout">
                    <i class='bx bx-log-out-circle'></i>
                    Đăng xuất
                </a>
            </li>
        </ul>
    </div>
    <!-- End of Sidebar -->
    <!-- Main Content -->
    <div class="content">
        <!-- Navbar -->
        <nav>
            <i class='bx bx-menu'></i>
            <form action="#">
                <div class="form-input">
                    <input type="search" id="Search" placeholder="Tìm kiếm...">
                    <button class="search-btn" type="submit"><i class='bx bx-search'></i></button>
                </div>
            </form>
            <input type="checkbox" id="theme-toggle" hidden>
            <label for="theme-toggle" class="theme-toggle"></label>
            <a href="#" class="notif">
                <i class='bx bx-bell'></i>
                <span class="count">12</span>
            </a>
            <a href="#" class="profile">
                <img src="~/image/QuanLy/logo.png" />
            </a>
        </nav>

        <!-- End of Navbar -->

        <main>

            <div class="bottom-data">
                <div class="orders">
                    <div class="header">
                        <i class='bx bx-user-circle'></i>
                        <h3>Quản lý tài xế</h3>
                        <i class='bx bx-filter'></i>
                        <i class='bx bx-search'></i>
                        <button class="add-button">Thêm tài xế</button>
                    </div>
                    <table>
                        <thead>
                            <tr>
                                <th>STT</th>
                                <th>Ảnh đại diện</th>
                                <th>Họ tên</th>
                                <th>Ngày tháng năm sinh</th>
                                <th>Email</th>
                                <th>Số điện thoại</th>
                                <th>Biển số</th>
                                <th>CCCD</th>
                                <th>Ngày đăng ký</th>
                                <th>Tùy chỉnh</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.taiXes.Count(); i++)
                            {
                                var item = Model.taiXes.ElementAt(i);
                                <tr class="Search" id="row_@item.MaTX">
                                    <td>@(i + 1).</td>
                                    <td><img src="~/image/TaiXe/@item.HinhAnh" alt=""></td>
                                    <td>@item.Ten</td>
                                    <td style="display:none;">@item.MaTX</td>
                                    <td>@item.NgayThangNamSinh.ToString("dd-MM-yyyy")</td>
                                    <td>@item.Email</td>
                                    <td>@item.SoDienThoai</td>
                                    <td>@item.BienSo</td>
                                    <td>@item.CCCD</td>
                                    @{
                                        string ngayDangKy = item.NgayDangKy.HasValue ? item.NgayDangKy.Value.ToString("dd-MM-yyyy") : "";
                                    }
                                    <td>@ngayDangKy</td>
                                    <td><button class="delete-button" data-id="@item.MaTX">Xóa</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </main>
    </div>
    <div id="popup" style="display:none;" class="popup-overlay">
        <div class="popup-content">
            <h3>Thêm tài xế</h3>
            <form id="add-form" enctype="multipart/form-data">

                <label>Họ tên:</label>
                <input type="text" name="Ten" required>

                <label>Ngày sinh:</label>
                <input type="date" name="NgayThangNamSinh" required>

                <label>Email:</label>
                <input type="email" name="Email" required>

                <label>Số điện thoại:</label>
                <input type="text" name="SoDienThoai" required>

                <label>Biển số:</label>
                <input type="text" name="BienSo" required>

                <label>CCCD:</label>
                <input type="text" name="CCCD" required>

                <label>Ngày đăng ký:</label>
                <input type="date" name="NgayDangKy" required />

                <label>Ảnh đại diện:</label>
                <input type="file" name="HinhAnh" accept="image/*" required>

                <button type="submit">Lưu</button>
                <button type="button" id="popup-cancel">Hủy</button>
            </form>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            function Contains(text_one, text_two) {
                var cleanTextOne = text_one.replace(/\s/g, "");
                var cleanTextTwo = text_two.replace(/\s/g, "");

                if (cleanTextOne.indexOf(cleanTextTwo) !== -1) {
                    return true;
                }
            }

            $("#Search").on('input', function () {
                var searchText = $("#Search").val().toLowerCase();
                $(".Search").each(function () {
                    if (!Contains($(this).text().toLowerCase(), searchText)) {
                        $(this).hide();
                    } else {
                        $(this).show();
                    }
                });
            });
        });
    </script>

    <script>
        $(document).ready(function () {
            // Hiển thị popup thêm
            $(".add-button").click(function () {
                $("#popup").show();
            });

            // Đóng popup
            $("#popup-cancel").click(function () {
                $("#popup").hide();
            });

            // Gửi dữ liệu thêm
            $("#add-form").submit(function (e) {
                e.preventDefault();

                var formData = new FormData(this);

                $.ajax({
                    url: '/QuanLy/ThemTaiXe',
                    type: 'POST',
                    data: formData,
                    contentType: false,
                    processData: false,
                    success: function () {
                        Swal.fire("Thành công!", "Đã thêm tài xế mới!", "success").then(() => location.reload());
                        $("#popup").hide();
                    },
                    error: function () {
                        Swal.fire("Lỗi!", "Không thể thêm tài xế.", "error");
                    }
                });
            });
        });
        $(".delete-button").click(function () {
            var id = $(this).data("id");

            Swal.fire({
                title: 'Bạn có chắc chắn?',
                text: "Hành động này không thể hoàn tác!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Xóa',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/QuanLy/XoaTaiXe', { id: id }, function (res) {
                        Swal.fire('Đã xóa!', 'Tài xế đã bị xóa.', 'success').then(() => location.reload());
                    }).fail(() => {
                        Swal.fire("Lỗi!", "Không thể xóa.", "error");
                    });
                }
            });
        });
    </script>
    <script src="~/js/BangDieuKhien.js"></script>
    <!-- Include jQuery library -->
</body>

</html>

