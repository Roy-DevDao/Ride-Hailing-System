@model WebsiteDatXeCongNghe.ViewModel.MultipleData.MultipleData
@{
    ViewBag.Title = "QuanLyQuyenTaiKhoan";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <link href="~/css/BangDieuKhien.css" rel="stylesheet" />

    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <title>Quản lý quyền tài khoản</title>
    <style>
    /* Nền mờ */
    .popup-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 1000;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    /* Hộp nội dung */
    .popup-content {
        background-color: #fff;
        padding: 30px 40px;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        width: 400px;
        max-width: 90%;
        animation: fadeIn 0.3s ease-in-out;
    }

    .popup-content h3 {
        margin-bottom: 20px;
        text-align: center;
        font-size: 20px;
        color: #333;
    }

    .popup-content label {
        font-weight: 600;
        display: block;
        margin-top: 10px;
        margin-bottom: 5px;
        color: #444;
    }

    .popup-content input[type="text"],
    .popup-content select {
        width: 100%;
        padding: 8px 12px;
        border: 1px solid #ccc;
        border-radius: 6px;
        box-sizing: border-box;
        font-size: 14px;
    }

    .popup-content button {
        margin-top: 20px;
        padding: 8px 16px;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-weight: bold;
        font-size: 14px;
    }

    .popup-content button[type="submit"] {
        background-color: #4CAF50;
        color: white;
        margin-right: 10px;
    }

    .popup-content button#edit-cancel {
        background-color: #f44336;
        color: white;
    }
    </style>

</head>

<body>

    <!-- Sidebar -->
    <div class="sidebar">
        <a href="#" class="logo">
            <i class='bx bx-code-alt'></i>
            <div class="logo-name"><span>Admin</span>Page</div>
        </a>
        <ul class="side-menu">
            <li><a href="/QuanLy/BangDieuKhien"><i class='bx bxs-dashboard'></i>Bảng điều khiển</a></li>
            <li><a href="/QuanLy/QuanLyKhachHang"><i class='bx bx-user-circle'></i>Quản lý khách hàng</a></li>
            <li><a href="/QuanLy/QuanLyTaiXe"><i class='bx bx-user-circle'></i>Quản lý tài xế</a></li>
            <li><a href="/QuanLy/QuanLyThongTinDatXe"><i class='bx bx-car'></i>Thông tin đặt xe</a></li>
            <li><a href="/QuanLy/QuanLyTaiKhoan"><i class='bx bx-key'></i>Quản lý tài khoản</a></li>
            <li><a href="/QuanLy/QuanLyDanhGia"><i class='bx bx-star'></i>Quản lý đánh giá</a></li>
            <li><a href="/QuanLy/QuanLyKhuyenMai"><i class='bx bx-money'></i>Quản lý khuyến mãi</a></li>
            <li><a href="/QuanLy/QuanLyThanhToan"><i class='bx bx-receipt'></i>Quản lý thanh toán</a></li>
            <li><a href="/QuanLy/QuanLyDanhGiaTaiXe"><i class='bx bx-star'></i>Đánh giá tài xế</a></li>
            <li><a href="/QuanLy/QuanLyTaiXeNhanChuyenXe"><i class='bx bx-cycling'></i>Tài xế nhận chuyến xe</a></li>
            <li><a href="/QuanLy/QuanLyTaiKhoanNganHang"><i class='bx bx-credit-card'></i>Tài khoản ngân hàng</a></li>
            <li class="active"><a href="/QuanLy/QuanLyQuyenTaiKhoan"><i class='bx bx-capsule'></i>Quyền tài khoản</a></li>
            <li><a href="/QuanLy/QuanLyPhanQuyen"><i class='bx bx-user-plus'></i>Quản lý phân quyền</a></li>
            <li><a href="#"><i class='bx bx-cog'></i>Cài đặt</a></li>
        </ul>
        <ul class="side-menu">
            <li>
                <a href="/TaiKhoan/DangXuat" class="logout">
                    <i class='bx bx-log-out-circle'></i>
                    Đăng xuất
                </a>
            </li>
        </ul>
    </div>
    <!-- End of Sidebar -->
    <!-- Main Content -->
    <div class="content">
        <!-- Navbar -->
        <nav>
            <i class='bx bx-menu'></i>
            <form action="#">
                <div class="form-input">
                    <input type="search" id="Search" placeholder="Tìm kiếm...">
                    <button class="search-btn" type="submit"><i class='bx bx-search'></i></button>
                </div>
            </form>
            <input type="checkbox" id="theme-toggle" hidden>
            <label for="theme-toggle" class="theme-toggle"></label>
            <a href="#" class="notif">
                <i class='bx bx-bell'></i>
                <span class="count">12</span>
            </a>
            <a href="#" class="profile">
                <img src="~/image/QuanLy/logo.png" />
            </a>
        </nav>

        <!-- End of Navbar -->

        <main>

            <div class="bottom-data">
                <div class="orders">
                    <div class="header">
                        <i class='bx bx-capsule'></i>
                        <h3>Quản lý quyền tài khoản</h3>
                        <i class='bx bx-filter'></i>
                        <i class='bx bx-search'></i>
                        <button class="add-button">Thêm tài khoản</button>
                    </div>
                    <table>
                        <thead>
                            <tr>
                                <th>STT</th>
                                <th>Số điện thoại</th>
                                <th>Quyền hạn</th>
                                <th colspan="2">Tùy chỉnh</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.quyenTaiKhoans.Count(); i++)
                            {
                                var item = Model.quyenTaiKhoans.ElementAt(i);
                                <tr class="Search" id="row_@item.MaQuyenTK">
                                    <td>@(i + 1).</td>
                                    <td style="display:none;">@item.MaQuyenTK</td>
                                    <td>@item.SoDienThoai</td>
                                    <td>
                                        @if (item.MaQuyen == 3)
                                        {
                                            <text>User</text>
                                        }
                                        else if (item.MaQuyen == 1)
                                        {
                                            <text>Super admin</text>
                                        }
                                        else if (item.MaQuyen == 2)
                                        {
                                            <text>Driver</text>
                                        }
                                        else
                                        {
                                            <text>Unknown</text>
                                        }

                                    </td>
                                    <td>
                                        <button class="edit-button"
                                                data-id="@item.MaQuyenTK"
                                                data-sdt="@item.SoDienThoai"
                                                data-maquyen="@item.MaQuyen">
                                            Sửa
                                        </button>
                                    </td>
                                    <td><button class="delete-button" data-id="@item.MaQuyenTK">Xóa</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>

                </div>
            </div>


        </main>
    </div>
    <div id="popup" style="display:none;" class="popup-overlay">
        <div class="popup-content">
            <h3>Sửa quyền tài khoản</h3>
            <form id="edit-form">
                <input type="hidden" id="edit-id" />
                <label>Số điện thoại:</label>
                <input type="text" id="edit-sdt" disabled/>

                <label>Quyền hạn:</label>
                <select id="edit-maquyen">
                    <option value="1">Super admin</option>
                    <option value="2">Driver</option>
                    <option value="3">User</option>
                </select>

                <button type="submit">Lưu</button>
                <button type="button" id="edit-cancel">Hủy</button>
            </form>
        </div>
    </div>
    <script>
        let isEditMode = false;
        $(document).ready(function () {
            function Contains(text_one, text_two) {
                var cleanTextOne = text_one.replace(/\s/g, "");
                var cleanTextTwo = text_two.replace(/\s/g, "");

                if (cleanTextOne.indexOf(cleanTextTwo) !== -1) {
                    return true;
                }
            }

            $("#Search").on('input', function () {
                var searchText = $("#Search").val().toLowerCase();
                $(".Search").each(function () {
                    if (!Contains($(this).text().toLowerCase(), searchText)) {
                        $(this).hide();
                    } else {
                        $(this).show();
                    }
                });
            });
            $(".delete-button").click(function () {
                var maQuyenTK = $(this).data("id");

                if (confirm("Bạn có chắc chắn muốn xóa quyền tài khoản này?")) {
                    $.ajax({
                        url: "/QuanLy/XoaQuyenTaiKhoan",
                        type: "POST",
                        data: { id: maQuyenTK },
                        success: function (result) {
                            alert("Xóa thành công!");
                            $("#row_" + maQuyenTK).remove();
                        },
                        error: function (xhr) {
                            alert("Xóa thất bại!");
                        }
                    });
                }
            });
            $("#edit-form").submit(function (e) {
                e.preventDefault();

                var id = $("#edit-id").val();
                var sdt = $("#edit-sdt").val();
                var maquyen = $("#edit-maquyen").val();

                if (sdt.trim() === "") {
                    alert("Số điện thoại không được để trống");
                    return;
                }

                if (isEditMode) {
                    // Gọi sửa
                    $.ajax({
                        url: "/QuanLy/SuaQuyenTaiKhoan",
                        type: "POST",
                        data: { id: id, maquyen: maquyen },
                        success: function () {
                            alert("Cập nhật thành công!");
                            location.reload();
                        },
                        error: function () {
                            alert("Cập nhật thất bại!");
                        }
                    });
                } else {
                    // Gọi thêm
                    $.ajax({
                        url: "/QuanLy/ThemQuyenTaiKhoan",
                        type: "POST",
                        data: { sdt: sdt, maquyen: maquyen },
                        success: function (res) {
                            if (res.success) {
                                alert("Thêm thành công!");
                                location.reload();
                            } else {
                                alert(res.message || "Thêm thất bại");
                            }
                        },
                        error: function () {
                            alert("Thêm thất bại!");
                        }
                    });
                }
            });
            // Ẩn popup khi nhấn "Hủy"
            $("#edit-cancel").click(function () {
                $("#popup").hide();
            });

            // Gửi yêu cầu cập nhật khi nhấn "Lưu"
            $(".edit-button").click(function () {
                isEditMode = true;

                var id = $(this).data("id");
                var sdt = $(this).data("sdt");
                var maquyen = $(this).data("maquyen");

                $("#edit-id").val(id);
                $("#edit-sdt").val(sdt).prop("disabled", true); // không cho sửa
                $("#edit-maquyen").val(maquyen);

                $(".popup-content h3").text("Sửa quyền tài khoản");
                $("#popup").show();
            });

            $(".add-button").click(function () {
                isEditMode = false;

                $("#edit-id").val("");
                $("#edit-sdt").val("").prop("disabled", false); // có thể nhập
                $("#edit-maquyen").val("");

                $(".popup-content h3").text("Thêm quyền tài khoản");
                $("#popup").show();
            });
        });
    </script>
    <style>
    </style>
    <!-- Scripts -->
    <script src="~/js/BangDieuKhien.js"></script>
    <!-- Include jQuery library -->
</body>

</html>

